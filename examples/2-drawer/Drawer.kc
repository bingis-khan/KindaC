use Term
use BoundedList
	BoundedList
use Alloc
	CAllocator
	Allocator(allocate)
use Iter
	for-each
	to
use Raycuck
	Color(RAYWHITE, WHITE, BLUE, BLACK, GREEN, YELLOW, ORANGE, GRAY, DARKGRAY)
	Rectangle
	Vector2
	MouseButton(MouseLeftButton, MouseRightButton)
	Key(KeyZ, KeyR)
	Texture2D
use Mem
use Retarded
use Math
use Error
	Failable(or-fail)
use Late
	Late
	late



f2i (x Float): x Retarded.cast() as Int
i2f (x Int): x Retarded.cast() as Float

Vec2
	x Int
	y Int

to-vec2 (Vector2 { x: x, y: y }): Vec2 { x: x f2i(), y: y f2i() }
from-vec2 (Vec2 { x: x, y: y }): Vector2 { x: x i2f(), y: y i2f() }

vec2-min (Vec2 { x: x1, y: y1 }, Vec2 { x: x2, y: y2 }):
	Vec2 { x: Math.min(x1, x2), y: Math.min(y1, y2) }

vec2-max (Vec2 { x: x1, y: y1 }, Vec2 { x: x2, y: y2 }):
	Vec2 { x: Math.max(x1, x2), y: Math.max(y1, y2) }

vec2-sub (Vec2 { x: x1, y: y1 }, Vec2 { x: x2, y: y2 }):
	Vec2 { x: x1 - x2, y: y1 - y2 }


GrabbedCorner
	UpperLeft
	UpperRight
	LowerLeft
	LowerRight

Rect
	x Int
	y Int
	width Int
	height Int


InputAction
	MkRect Vec2
	MoveRect Rect Vec2
	ResizeRect Rect GrabbedCorner Vec2
	SelectActionListElem  # currently unused!
	MkArrow Vec2

show-input-action (input-action)
	case input-action
		MkRect(_)
			return 'MkRect'
		MoveRect(_, _)
			return 'MoveRect'
		ResizeRect(_, _, _)
			return 'ResizeRect'
		SelectActionListElem
			return 'SelectActionListElem'
		MkArrow(_)
			return 'MkArrow'

maybe (mx, replacement, f)
	case mx
		Just(x)
			return f(x)
		None
			return replacement


as-rectangle (r Rect): Rectangle {
	x: r.x i2f(),
	y: r.y i2f(),
	width: r.width i2f(),
	height: r.height i2f()
}

# creates a rectangle BETWEEN specified vectors
mk-rect (v1 Vec2, v2 Vec2) -> Rect
	ul = vec2-min(v1, v2)
	dr = vec2-max(v1, v2)
	widths = vec2-sub(dr, ul)
	return Rect {
		x: ul.x,
		y: ul.y,
		width: widths.x,
		height: widths.y
	}

resize-grip-radius = 5
is-not-too-small (r Rect):
	Math.min(r.width, r.height) > 2 * resize-grip-radius

get-resizing-corner(r Rect, mp Vec2) -> Maybe GrabbedCorner
	mpv = mp from-vec2()
	radius = resize-grip-radius i2f()
	if Raycuck.check-collision-point-circle(mpv, Vec2 { x: r.x, y: r.y } from-vec2(), radius)
		return Just(UpperLeft)
	if Raycuck.check-collision-point-circle(mpv, Vec2 { x: r.x, y: r.y + r.height } from-vec2(), radius)
		return Just(LowerLeft)
	if Raycuck.check-collision-point-circle(mpv, Vec2 { x: r.x + r.width, y: r.y } from-vec2(), radius)
		return Just(UpperRight)
	if Raycuck.check-collision-point-circle(mpv, Vec2 { x: r.x + r.width, y: r.y + r.height } from-vec2(), radius)
		return Just(LowerRight)

	return None


resize (r Rect, corner GrabbedCorner, md Vec2) -> Rect
	case corner
		UpperLeft
			return r {
					x: r.x + md.x,
					y: r.y + md.y,
					width: r.width - md.x,
					height: r.height - md.y
				}
		UpperRight
			return r {
					y: r.y + md.y,
					width: r.width + md.x,
					height: r.height - md.y
				}
		LowerLeft
			return r {
					x: r.x + md.x,
					width: r.width - md.x,
					height: r.height + md.y
				}
		LowerRight
			return r {
					width: r.width + md.x,
					height: r.height + md.y
				}


Arrow
	from-x Int
	from-y Int
	to-x Int
	to-y Int

mk-arrow (v1 Vec2, v2 Vec2):
	Arrow { from-x: v1.x, from-y: v1.y, to-x: v2.x, to-y: v2.y }


State
	rects BoundedList Rect
	arrows BoundedList Arrow


ActionIcon
	MkRectIcon
	MoveRectIcon
	ResizeRectIcon
	MkArrowIcon


Action
	undo Ptr State -> Unit
	redo Ptr State -> Unit
	# icon Ptr (Late Texture2D)  # i wish it was this, but there's an empty union hidden somewhere. i don't feel like diagnosing it now.
	icon ActionIcon

# had to divide it, because we don't yet have circular datatype references.
FullState
	state State

	actions BoundedList Action
	current-action Int

mk-state (al): FullState {
		state: State { rects: BoundedList.mk(al allocate(100)), arrows: BoundedList.mk(al allocate(100)) },
		actions: BoundedList.mk(al allocate(100)),
		current-action: -1
	}


draw-arrow (ar Arrow) -> Unit
	if ar.to-x - ar.from-x > ar.to-y - ar.from-y
		Raycuck.draw-line(ar.from-x, ar.from-y, ar.to-x, ar.from-y, BLACK)
		Raycuck.draw-line(ar.to-x, ar.from-y, ar.to-x, ar.to-y, BLACK)
	else
		Raycuck.draw-line(ar.from-x, ar.from-y, ar.from-x, ar.to-y, BLACK)
		Raycuck.draw-line(ar.from-x, ar.to-y, ar.to-x, ar.to-y, BLACK)

	return

draw-rect (r Rect) -> Unit
	thickness = 5 i2f()
	Raycuck.draw-rectangle-rec(r as-rectangle(), RAYWHITE)
	Raycuck.draw-rectangle-lines-ex(r as-rectangle(), thickness, BLACK)
	return

draw-state (state Ptr FullState) -> Unit
	state&.state.rects for-each(draw-rect)
	state&.state.arrows for-each(draw-arrow)
	return



try-last-rect (state Ptr State) -> Maybe (Ptr Rect)
	if state&.rects.count == 0
		return None
	else
		return (&state&.rects) BoundedList.get-ptr(state&.rects.count - 1) Just()

last-rect (state Ptr State):
	state try-last-rect() or-fail('expect a rectangle to be here.')

add-action (fs Ptr FullState, action Action) -> Unit
	actions =& fs&.actions
	fs <&.current-action= fs&.current-action + 1

	if fs&.current-action > actions&.count
		Error.critical('For some reason, current action is \(fs&.current-action) and num of actions is \(actions&.count)')
	if fs&.current-action == actions&.count
		actions BoundedList.add(action)
	else
		actions BoundedList.set(fs&.current-action, action)

	actions <&.count= fs&.current-action + 1
	return

set-last-rect (state Ptr State, new-rect Rect) -> Unit
	r = state last-rect()
	r <&= new-rect
	return

max-undo-actions = 14  # a ui thing, so that the bar at the bottom won't be too big.
undo (full Ptr FullState) -> Unit
	if full&.current-action < 0
		return

	actions =& full&.actions
	cur = full&.current-action
	full <&.current-action= cur - 1
	x = BoundedList.get(actions, cur)
	x.undo(&full&.state)

	# trim undo list
	if full&.actions.count > cur + max-undo-actions - 1
		# if the list was smaller than max, keep the size.
		if actions&.count > max-undo-actions
			actions <&.count= Math.max(cur + max-undo-actions - 1, max-undo-actions)
			
	
	return

redo (full Ptr FullState) -> Unit
	if full&.current-action >= full&.actions.count - 1
		return

	actions =& full&.actions
	cur = full&.current-action
	full <&.current-action= cur + 1
	x = BoundedList.get(actions, cur + 1)
	x.redo(&full&.state)
	return


# either undo or redo stuff.
#  (we assume new-current-action is already checked for bounds)
actions-to (full Ptr FullState, new-current-action Int) -> Unit
	cur = full&.current-action

	# dont do shit
	if new-current-action == cur
		return

	# undo a lot
	if new-current-action < cur
		new-current-action to (cur - 1) for-each(i: undo(full))
		return

	# redo a lot
	cur to (new-current-action - 1) for-each(i: redo(full))


block-size = 40
mouse-on-bar-elem (fs Ptr FullState) -> Maybe Int
	action-list-size = Math.min(max-undo-actions, fs&.actions.count)
	bar-size = action-list-size * block-size
	sw = Raycuck.get-screen-width()
	sh = Raycuck.get-screen-height()
	begin-x = (sw - bar-size) / 2
	mp = Raycuck.get-mouse-position() to-vec2()

	# return if mouse height won't allow it to be even clicked.
	if mp.y <= sh - block-size or mp.y >= sh
		return None

	# try calculate the position.
	try-elem = (mp.x - begin-x) / block-size
	if try-elem < 0 or try-elem >= action-list-size
		return None
	return Just(try-elem)



line-thickness = 5
texture (s ConstStr) -> Late Texture2D
	load-tex ()
		image = Raycuck.load-image(s)
		Raycuck.image-resize(&image, block-size - 2*line-thickness, block-size - 2*line-thickness)
		return Raycuck.load-texture-from-image(image)

	return late(load-tex)


create-block-tex =& texture('img/create_block.png')
move-rect-tex    =& texture('img/move_block.png')
resize-rect-tex  =& texture('img/resize_block.png')
create-arrow-tex =& texture('img/create_arrow.png')

get-icon (ai)
	case ai
		MkRectIcon
			return Late.get(create-block-tex)
		MoveRectIcon
			return Late.get(move-rect-tex)
		ResizeRectIcon
			return Late.get(resize-rect-tex)
		MkArrowIcon
			return Late.get(create-arrow-tex)



handle-input (input Maybe InputAction, mp Vec2, full Ptr FullState) -> Maybe InputAction
	state =& full&.state
	case input
		# no input - "wait" for action
		None
			action-list-elem = mouse-on-bar-elem(full)
			if action-list-elem /= None and Raycuck.is-mouse-button-down(MouseLeftButton)
				actions-to(full, action-list-elem or-fail('expected selected action list elem') + full&.actions.count - Math.min(max-undo-actions, full&.actions.count))
				return None

			elif Raycuck.is-key-pressed(KeyZ)
				undo(full)

			elif Raycuck.is-key-pressed(KeyR)
				redo(full)

			elif Raycuck.is-mouse-button-pressed(MouseLeftButton) and state try-last-rect() maybe(False, r: r& is-not-too-small() and r& get-resizing-corner(mp) /= None)
				r = state try-last-rect() or-fail('expect rect')&
				return Just(ResizeRect(state last-rect()&, r get-resizing-corner(mp) or-fail('last time it wasnt None...'), mp))

			elif Raycuck.is-mouse-button-pressed(MouseLeftButton) and state try-last-rect() maybe(False, r: Raycuck.check-collision-point-rec(mp from-vec2(), r& as-rectangle()))
				return Just(MoveRect(state last-rect()&, mp))

			elif Raycuck.is-mouse-button-pressed(MouseLeftButton)
				return Just(MkRect(mp))

			elif Raycuck.is-mouse-button-pressed(MouseRightButton)
				return Just(MkArrow(mp))

			return None

		Just(action)
			case action
				MkRect(begin-rect)
					if Raycuck.is-mouse-button-up(MouseLeftButton)
						r = mk-rect(begin-rect, mp)
						(&state&.rects) BoundedList.add(r)
						full add-action(Action { undo: s: BoundedList.pop(&s&.rects) void(), redo: s: BoundedList.add(&s&.rects, r), icon: MkRectIcon })
						return None

					return Just(MkRect(begin-rect))

				MkArrow(begin-arrow)
					if Raycuck.is-mouse-button-up(MouseRightButton)
						arr = Arrow { from-x: begin-arrow.x, from-y: begin-arrow.y, to-x: mp.x, to-y: mp.y }
						(&state&.arrows) BoundedList.add(arr)
						full add-action(Action { undo: s: BoundedList.pop(&s&.arrows) void(), redo: s: BoundedList.add(&s&.arrows, arr), icon: MkArrowIcon })
						return None

					return Just(MkArrow(begin-arrow))

				MoveRect(init-rect, last-pos)
					if Raycuck.is-mouse-button-up(MouseLeftButton)
						current-rect = state last-rect()&
						full add-action(Action { undo: s: s set-last-rect(init-rect), redo: s: s set-last-rect(current-rect), icon: MoveRectIcon })
						return None

					md = vec2-sub(mp, last-pos)
					selected = state try-last-rect() or-fail('attempting to move a rectangle which does not exist.')

					selected <&= (selected&) { x: selected&.x + md.x, y: selected&.y + md.y }

					return Just(MoveRect(init-rect, mp))

				ResizeRect(init-rect, resize-point, last-pos)
					if Raycuck.is-mouse-button-up(MouseLeftButton)
						current-rect = state last-rect()&
						full add-action(Action { undo: s: s set-last-rect(init-rect), redo: s: s set-last-rect(current-rect), icon: ResizeRectIcon })
						return None

					md = vec2-sub(mp, last-pos)
					selected = state try-last-rect() or-fail('expect rect')
					selected <&= selected& resize(resize-point, md)

					return Just(ResizeRect(init-rect, resize-point, mp))

				_
					return input



draw-input-stuff (input Maybe InputAction, mp Vec2) -> Unit
	case input
		Just(MkRect(v1))
			Raycuck.draw-rectangle-rec(mk-rect(v1, mp) as-rectangle(), BLUE)

		Just(MkArrow(v1))
			draw-arrow(mk-arrow(v1, mp))

		_
			pass

	return

draw-resize-corners (state Ptr FullState) -> Unit
	state =& state&.state
	case state try-last-rect()
		None
			pass

		Just(r)
			r = r&
			if not is-not-too-small(r)
				return

			Raycuck.draw-circle(r.x, r.y, resize-grip-radius i2f(), YELLOW)
			Raycuck.draw-circle(r.x, r.y + r.height, resize-grip-radius i2f(), YELLOW)
			Raycuck.draw-circle(r.x + r.width, r.y, resize-grip-radius i2f(), YELLOW)
			Raycuck.draw-circle(r.x + r.width, r.y + r.height, resize-grip-radius i2f(), YELLOW)



draw-action-list (fs Ptr FullState) -> Unit
	sw = Raycuck.get-screen-width()
	sh = Raycuck.get-screen-height()
	action-list-size = Math.min(max-undo-actions, fs&.actions.count)
	bar-size = action-list-size * block-size

	current-action = fs&.current-action
	begin-x = (sw - bar-size) / 2
	draw-action-block (i)
		rx = begin-x + i * block-size
		ry = sh - block-size
		block = Rect { x: rx, y: ry, width: block-size, height: block-size }

		list-i = fs&.actions.count - action-list-size + i  # corresponds to action index.
		if list-i < current-action
			Raycuck.draw-rectangle-rec(block as-rectangle(), RAYWHITE)
			Raycuck.draw-rectangle-lines-ex(block as-rectangle(), line-thickness i2f(), BLACK)
		elif list-i == current-action
			Raycuck.draw-rectangle-rec(block as-rectangle(), YELLOW)
			Raycuck.draw-rectangle-lines-ex(block as-rectangle(), line-thickness i2f(), ORANGE)
		else
			Raycuck.draw-rectangle-rec(block as-rectangle(), GRAY)
			Raycuck.draw-rectangle-lines-ex(block as-rectangle(), line-thickness i2f(), DARKGRAY)

		cur-action = (&fs&.actions) BoundedList.get(list-i)
		Raycuck.draw-texture(get-icon(cur-action.icon), rx + line-thickness, ry + line-thickness, WHITE)
		return

	0 to (action-list-size - 1) for-each(draw-action-block)

	return


# main program!

Raycuck.init-window(800, 600, 'miau')
Raycuck.set-target-fps(60)

al = Alloc.get-c-allocator()
state =& mk-state(al)
input-action = None

while not Raycuck.window-should-close()
	mp = Raycuck.get-mouse-position() to-vec2()
	
	input-action <= handle-input(input-action, mp, state)

	Raycuck.begin-drawing()
	Raycuck.clear-background(RAYWHITE)

	draw-state(state)
	draw-input-stuff(input-action, mp)
	draw-resize-corners(state)
	Raycuck.draw-text(input-action maybe('none', show-input-action), 0, 0, 20, BLACK)
	draw-action-list(state)
	
	Raycuck.end-drawing()

Raycuck.close-window()
